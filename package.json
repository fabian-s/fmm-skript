{
  "name": "interactive-textbook-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run gen:toc && vite",
    "build": "npm run gen:toc && npm run typecheck:mdx && npm run test:mdx && npm run test:lib && tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "bash scripts/deploy.sh",
    "test:mdx": "node mdx/fixtures.test.mjs && node mdx/inventory.test.mjs",
    "test:lib": "node --experimental-strip-types --no-warnings src/lib/widgets/util.test.mjs",
    "verify:numbers": "node scripts/verify/run-all.mjs",
    "typecheck:mdx": "node mdx/typecheck.mjs",
    "mdx:compare": "node mdx/compare.mjs",
    "gen:toc": "node scripts/gen-toc.mjs",
    "pdf": "bash scripts/pdf/build.sh"
  },
  "dependencies": {
    "@fontsource-variable/libre-franklin": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "mathjax": "^3.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/mdx": "^2.0.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "acorn": "^8.18.0",
    "acorn-jsx": "^5.3.2",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.2",
    "unist-util-visit": "^5.1.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
